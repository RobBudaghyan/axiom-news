# Axiom News v2 - environment variables
# Copy this file to `.env` (same folder) and fill in values. `.env` is gitignored.
# Never paste these values into chat. In production the same names are stored as
# GitHub Actions secrets (hourly job) and Cloudflare Worker secrets (bot + Mini App).
# Nothing below is needed for Step 1 (the feed checker needs no keys).

# --- Telegram ---
# Bot token from @BotFather. During development this is the TEST bot's token,
# NOT the real @axiom_news_bot. Format: 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (not @username). Only this account sees the
# Admin tab in the Mini App. Get it from @userinfobot.
OWNER_TELEGRAM_ID=
# Random string (letters/digits, 32+ chars) that Telegram sends back with every
# webhook call so the Worker can reject fake requests. Make one up or generate it.
TELEGRAM_WEBHOOK_SECRET=

# --- AI providers (free tiers, no billing) ---
# Gemini API key from https://aistudio.google.com/apikey, created in a Google Cloud
# project that has NO billing account attached (keeps it on the free tier).
GEMINI_API_KEY=
# Gemini model id. Model names get retired; check before changing (see docs/LESSONS.md).
GEMINI_MODEL=gemini-3.5-flash-lite
# Second Gemini model, tried when the first one is overloaded (HTTP 503) or rate-limited.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Fallback provider (Groq free plan), used only when Gemini fails or is rate-limited.
# Key from https://console.groq.com/keys . See docs/ARCHITECTURE.md section 7.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Cloudflare (database access from the hourly GitHub job) ---
# Cloudflare account id (dashboard -> Workers & Pages -> right sidebar "Account ID").
CLOUDFLARE_ACCOUNT_ID=
# The D1 database id (dashboard -> Storage & Databases -> D1 -> your database).
D1_DATABASE_ID=
# API token with ONLY "Account / D1 / Edit" permission. Used by the hourly job to
# write stories into D1. Do not use a global API key.
CLOUDFLARE_D1_TOKEN=
# Step 17: API token with ONLY "Account / Account Analytics / Read". The production Worker checks
# the account's free limits with it once an hour (D1 rows, Worker CPU) and alerts the owner at 80%.
CLOUDFLARE_ANALYTICS_TOKEN=

# --- GitHub (the Worker starts the hourly job) ---
# Fine-grained personal access token: only the axiom-news repository, permission
# "Actions: Read and write" (Metadata read-only is added automatically). Stored as a Worker
# secret; the GitHub job itself does not need it.
GITHUB_DISPATCH_TOKEN=

# --- App settings ---
# Time zone used for a user until the Mini App detects theirs (IANA name).
DEFAULT_TIMEZONE=Asia/Yerevan
